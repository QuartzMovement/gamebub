import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { Button } from "../components/button.slint";

export component MainMenuScreen inherits ScreenBase {
    forward-focus: btn-cart;
    i-focus-scope := FocusScope {
        VerticalLayout {
            alignment: start;
            height: 100%;
            padding: 8px;
            spacing: 8px;

            Image {
                source: @image-url("../../logo.png");
                height: 22px;
            }

            GridLayout {
                spacing: 4px;
                Row {
                    btn-cart := Button {
                        width: 50%;
                        height: 32px;
                        text: "Run Cartridge";
                        on-right => {
                            btn-rom.focus();
                            accept
                        }
                        on-down => {
                            btn-settings.focus();
                            accept
                        }
                        on-pressed => {
                            Global.set-screen(ScreenId.Game);
                            Backend.main-menu-run-cartridge();
                        }
                    }

                    btn-rom := Button {
                        width: 50%;
                        height: 32px;
                        text: "Load ROM";
                        on-left => {
                            btn-cart.focus();
                            accept
                        }
                        on-down => {
                            btn-tools.focus();
                            accept
                        }
                        on-pressed => {
                            Global.set-screen(ScreenId.RomSelect);
                            Backend.main-menu-load-rom();
                        }
                    }
                }

                Row {
                    btn-settings := Button {
                        text: "Settings";
                        on-up => {
                            btn-cart.focus();
                            accept
                        }
                        on-right => {
                            btn-tools.focus();
                            accept
                        }
                        on-down => {
                            btn-power-off.focus();
                            accept
                        }
                        on-pressed => {
                            Global.set-screen(ScreenId.Settings);
                        }
                    }

                    btn-tools := Button {
                        text: "Tools";
                        on-up => {
                            btn-rom.focus();
                            accept
                        }
                        on-left => {
                            btn-settings.focus();
                            accept
                        }
                        on-down => {
                            btn-power-off.focus();
                            accept
                        }
                    }
                }

                Row {
                    btn-power-off := Button {
                        text: "Power Off";
                        colspan: 2;
                        on-up => {
                            btn-settings.focus();
                            accept
                        }
                        on-pressed => {
                            Backend.power-off();
                        }
                    }
                }
            }
        }
    }
}
