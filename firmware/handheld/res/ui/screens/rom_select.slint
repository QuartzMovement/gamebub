import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { TextListView } from "../components/list_view.slint";

export component RomSelectScreen inherits ScreenBase {
    in property <[string]> files;
    private property <bool> is-loading: false;

    title: "Load ROM...";
    forward-focus: list;

    files: Backend.rom-select-list;
    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "b") {
                Global.set-screen(ScreenId.MainMenu);
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            height: 100%;
            spacing: 2px;

            Text {
                text: Backend.rom-select-path;
            }

            list := TextListView {
                model: root.files;
                wrap: true;
                init => {
                    self.set-focus-item(Backend.rom-select-initial);
                }
                on-item-selected(i) => {
                    is-loading = true;
                    if Backend.rom-select-selected(i) {
                        self.set-focus-item(0);
                    } else {
                        i-loading-popup.focus();
                    }
                }
            }

            HorizontalLayout {
                Text {
                    text: "A: Select";
                }

                Text {
                    text: "B: Cancel";
                    horizontal-alignment: right;
                }
            }
        }
    }

    i-loading-popup := FocusScope {
        visible: is-loading;
        Rectangle {
            background: #FFF;
            border-color: black;
            border-width: 1px;
            width: i-layout.min-width;
            height: i-layout.min-height;

            i-layout := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text {
                    horizontal-alignment: center;
                    text: "Loading...";
                }
            }
        }
    }
}
