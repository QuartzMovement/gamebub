import { Global, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { TextListView } from "../components/list_view.slint";

export component RomSelectScreen inherits ScreenBase {
    in property <[string]> files;

    title: "Load ROM...";
    forward-focus: list;

    files: Backend.rom-select-list;
    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == "b") {
                Global.set-screen(ScreenId.MainMenu);
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            height: 100%;
            spacing: 2px;

            Text {
                text: Backend.rom-select-path;
            }

            list := TextListView {
                model: root.files;
                wrap: true;
                init => {
                    self.set-focus-item(Backend.rom-select-initial);
                }
                on-item-selected(i) => {
                    if Backend.rom-select-selected(i) {
                        Global.set-screen(ScreenId.Game);
                    } else {
                        self.set-focus-item(0);
                    }
                }
            }

            HorizontalLayout {
                Text {
                    text: "A: Select";
                }

                Text {
                    text: "B: Cancel";
                    horizontal-alignment: right;
                }
            }
        }
    }
}
